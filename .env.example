# Copia questo file in .env.local per lo sviluppo locale (letto automaticamente
# da `npm run dev`). Su Vercel le variabili si impostano da Project Settings →
# Environment Variables. Non committare mai un file con valori reali.

# Chiave SEGRETA di Stripe (sk_live_... in produzione, sk_test_... in sviluppo).
# NON è la chiave pubblicabile (pk_...). Usata solo dalle funzioni serverless.
STRIPE_SECRET_KEY=sk_test_...

# Stringa lunga e casuale, generata una sola volta (es. `openssl rand -hex 32`).
# Firma i token di accesso alla dashboard: se cambia, tutti gli accessi già
# emessi smettono di funzionare e gli utenti dovranno ripetere la verifica.
ACCESS_TOKEN_SECRET=cambia-questa-stringa-con-un-valore-casuale-lungo
